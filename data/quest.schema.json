{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SideQuest Lab Quest",
  "type":"object",
  "additionalProperties":false,
  "required":["id","title","category","description","duration","budget","moods","companions","difficulty","xp","steps","completionCriteria"],
  "properties":{
    "id":{"type":"string","pattern":"^quest-[0-9]{3,}$"},
    "title":{"type":"string","minLength":2,"maxLength":40},
    "category":{"enum":["exploration","creativity","wellbeing","social","learning"]},
    "description":{"type":"string","minLength":8,"maxLength":240},
    "duration":{"type":"integer","minimum":5,"maximum":1440},
    "budget":{"type":"integer","minimum":0,"maximum":10000},
    "moods":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["curious","calm","bored","energetic"]}},
    "companions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["solo","friends","family"]}},
    "difficulty":{"enum":["easy","medium","hard"]},
    "xp":{"type":"integer","minimum":10,"maximum":100},
    "steps":{"type":"array","minItems":2,"maxItems":8,"items":{"type":"string","minLength":4}},
    "completionCriteria":{"type":"string","minLength":5}
  }
}
